# The xtool build Forge is tested with. One source of truth: read by
# scripts/install-xtool.sh (and so environment.json) and by `forge doctor`,
# which warns when the installed xtool reports a different version.
#
# This is the patched build from the fork GeneralKnowledge/xtool, branch
# `ixos` (upstream 1.24.0 plus four fixes of ours and five upstream PRs; see
# docs/compatibility.md). The binary lives on the fork's `ixos-bin` branch and
# is fetched by commit, so the URL can't change under us. To move the pin:
# push a new AppImage to `ixos-bin`, then update all three lines together.
XTOOL_VERSION=1.24.0-ixos.1
XTOOL_URL_X86_64=https://raw.githubusercontent.com/GeneralKnowledge/xtool/6f8b94e646714a7d12711db6f73e3449321b3d72/xtool-x86_64.AppImage
XTOOL_SHA256_X86_64=afceb40a4928c51ec38d74bdf23c34a2fd2f49dedd0614f19e298e732ef82161
