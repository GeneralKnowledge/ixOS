<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- iroh connections to other devices, and Relay's relay and lookup servers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Which networks this device is on, for iroh's routes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Finding code senders and trusted devices with NsdManager (mDNS). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Message notifications from a chat server's rooms (Android 13 and later ask first). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No backups: this device's key and the chat server account are sealed by a Keystore key
         that can't leave the phone, and Relay's data (and any `device.key` from before the
         Keystore) must never leave it either, as the iPhone keeps the identity out of backups. -->
    <application
        android:name=".RelayApplication"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/relay_no_backup"
        android:label="Relay"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notifications whose time has come, and Reply / Mark as Read on one. -->
        <receiver
            android:name=".host.NotificationReceiver"
            android:exported="false" />

        <!-- Received files open in other apps through content URIs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/relay_files" />
        </provider>
    </application>

</manifest>
